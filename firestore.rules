rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Red de seguridad: nada accesible salvo lo permitido explícitamente abajo.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Administradores por email. Debe coincidir con ADMIN_EMAILS en App.tsx.
    // El rol se decide aquí, no por un campo escribible por el propio usuario
    // (eso sería una escalada de privilegios).
    function adminEmails() {
      return ['vilacos@gmail.com'];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in adminEmails();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validaciones ---

    // Datos públicos: NUNCA pueden contener información personal.
    function isValidPublic(data) {
      return data.keys().hasAll(['pseudonym', 'avatar', 'initialWeight', 'totalPoints', 'totalWeightLoss', 'isAdmin']) &&
             data.pseudonym is string && data.pseudonym.size() > 0 && data.pseudonym.size() <= 50 &&
             data.avatar is string && data.avatar.size() <= 500 &&
             data.initialWeight is number && data.initialWeight > 0 &&
             data.totalPoints is number && data.totalPoints >= 0 &&
             data.totalWeightLoss is number &&
             data.isAdmin is bool;
    }

    // Datos privados: nombre real e historial de pesajes.
    function isValidPrivate(data) {
      return data.keys().hasAll(['realName', 'history']) &&
             data.realName is string && data.realName.size() > 0 && data.realName.size() <= 100 &&
             data.history is list && data.history.size() <= 2000;
    }

    function isValidCompetitionConfig(data) {
      return data.keys().hasAll(['startDate', 'endDate', 'prizeDescription']) &&
             data.startDate is string &&
             data.endDate is string &&
             data.prizeDescription is string && data.prizeDescription.size() <= 500;
    }

    // ==========================================================
    // /leaderboard/{userId} → DATOS PÚBLICOS (alimenta el ranking)
    // Lo lee cualquier usuario con sesión. Nada personal aquí.
    // ==========================================================
    match /leaderboard/{userId} {
      allow read: if isSignedIn();

      // Alta: el propio usuario (nunca auto-ascendido a admin) o un admin.
      allow create: if isValidPublic(incoming()) &&
                      ((isOwner(userId) && incoming().isAdmin == false) || isAdmin());

      // Modificación: un admin puede todo; el dueño solo sus propios datos y
      // no puede tocarse el rol (evita el auto-ascenso a admin).
      allow update: if isValidPublic(incoming()) && (
                      isAdmin() ||
                      (isOwner(userId) &&
                       incoming().isAdmin == existing().isAdmin &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['totalPoints', 'totalWeightLoss', 'pseudonym', 'avatar']))
                    );

      allow delete: if isAdmin();
    }

    // ==========================================================
    // /users/{userId} → DATOS PRIVADOS (nombre real, historial)
    // Solo su dueño o un administrador.
    // ==========================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isValidPrivate(incoming()) && (isOwner(userId) || isAdmin());

      // El dueño solo puede añadir pesajes (el historial); el resto de sus
      // datos privados no son editables desde el cliente.
      allow update: if isValidPrivate(incoming()) && (
                      isAdmin() ||
                      (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['history']))
                    );

      allow delete: if isAdmin();
    }

    // ==========================================================
    // /settings/competition → configuración del reto
    // ==========================================================
    match /settings/competition {
      allow read: if true; // Público: la landing muestra las fechas del reto
      allow write: if isAdmin() && isValidCompetitionConfig(incoming());
    }
  }
}
